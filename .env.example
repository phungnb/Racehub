# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server (route /api/*). Tuyệt đối không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Strava (https://www.strava.com/settings/api) ---
NEXT_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký tham số state của OAuth.
# Tạo bằng: openssl rand -hex 32
OAUTH_STATE_SECRET=
# Token tùy chọn để xác thực webhook Strava (GĐ 1)
STRAVA_WEBHOOK_VERIFY_TOKEN=
# ID subscription webhook Strava (sau khi đăng ký, xem HUONG_DAN_TRIEN_KHAI.md)
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# --- Tác vụ định kỳ (Vercel Cron) ---
# Vercel tự gửi header "Authorization: Bearer <CRON_SECRET>" khi gọi /api/cron/*.
# Tạo bằng: openssl rand -hex 24
CRON_SECRET=

# --- Thông báo đẩy (Web Push) ---
# Tạo một lần bằng: npx web-push generate-vapid-keys
# Khóa công khai được nhúng vào trình duyệt; khóa riêng chỉ ở server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Email hỗ trợ hiện ở trang Chính sách / Điều khoản (không bắt buộc)
NEXT_PUBLIC_SUPPORT_EMAIL=
VAPID_PRIVATE_KEY=
# Liên hệ khi dịch vụ push cần báo sự cố: mailto:<email> hoặc https://<tên-miền>. Bỏ trống = dùng tên miền app.
VAPID_SUBJECT=
